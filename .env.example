# Senha inicial da conta de juiz com login "admin".
# Troque por uma senha longa antes de iniciar o servidor pela primeira vez.
DECKCHECK_APP_PASSWORD=troque-esta-senha

# false para acesso HTTP privado pelo Tailscale; true somente atrás de HTTPS.
DECKCHECK_SECURE_COOKIES=false

# O domínio gratuito atribuído no painel e o Authtoken da conta ngrok.
NGROK_DOMAIN=
NGROK_AUTHTOKEN=
NGROK_AGENT_DOMAIN=default.internal
